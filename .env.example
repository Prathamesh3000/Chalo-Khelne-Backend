# ──────────────────────────────────────────────────────────────
# Chalo Khelne — server environment template
# Copy to `.env` and fill in REAL values. NEVER commit the real .env.
# Only variables the server code actually reads are listed as active below.
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ──────────────────────────────────────────────────────────────

# ── Core (REQUIRED — server refuses to boot without these) ──
NODE_ENV=development                                                   # development | production
PORT=3003
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/chalokhelne   # use a dedicated least-privilege DB user — NOT admin:admin

# ── Auth / JWT (JWT_SECRET REQUIRED) ──
JWT_SECRET=your_strong_random_jwt_secret_here          # REQUIRED — >= 32 chars, high entropy
JWT_RESET_SECRET=your_strong_random_reset_secret_here  # password-reset tokens (passwordReset.js) — strongly recommended

# ── CORS (REQUIRED in production) ──
WEB_ALLOWED_ORIGINS=https://chalokhelne.com            # comma-separated web origins; leave blank in dev (localhost allowed)

# ── Frontend (used in email links — NEVER localhost in production) ──
FRONTEND_URL=https://chalokhelne.com

# ── Email / nodemailer (recommended — email features fail without it) ──
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password             # Gmail App Password, NOT the account password
EMAIL_FROM=no-reply@chalokhelne.com

# ── Google Sign-In (optional — only if Google login is enabled) ──
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# ── Sign in with Apple (REQUIRED for the iOS build — App Store Guideline 4.8) ──
APPLE_CLIENT_ID=com.chalokhelnesport.client            # iOS bundle id = the `aud` of the identity token. Comma-separate to also accept a web Service ID. Defaults to this value if unset.

# Apple token revocation on account deletion (Guideline 5.1.1(v)).
# ⚠️ MUST be configured before the iOS release. Until then account deletion
# still works, but logs a warning instead of revoking the Apple token.
# Generate the .p8 "Sign in with Apple" key at developer.apple.com → Keys.
APPLE_TEAM_ID=                                         # 10-char Apple Developer Team ID
APPLE_KEY_ID=                                          # 10-char Key ID of the .p8 key
APPLE_PRIVATE_KEY=                                     # contents of AuthKey_<KEYID>.p8 (newlines may be written as \n)
APPLE_JWKS_TTL_MS=                                     # optional; in-memory JWKS cache TTL, default 21600000 (6h)

# ── Redis (optional; REQUIRED for multi-instance / Phase 2 HA) ──
REDIS_URL=                                             # powers BOTH multi-instance-safe rate limits AND the Socket.io adapter; blank = in-memory (single-instance only). For the socket adapter also run: npm install @socket.io/redis-adapter

# ── Uploads (optional) ──
UPLOADS_DIR=                                           # absolute path for uploaded files; blank = <server>/uploads

# ── Error tracking (optional but recommended in production) ──
SENTRY_DSN=                                            # Sentry project DSN; blank = error tracking off. Requires: npm install @sentry/node

# ── TLS (only when USE_SSL=true; usually terminated at a proxy in prod) ──
USE_SSL=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# ──────────────────────────────────────────────────────────────
# RESERVED — these appear in some legacy .env files but are NOT currently
# read by any server code. Setting them does nothing until the matching
# integration is actually wired. Documented here only to avoid confusion.
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET   (no Razorpay SDK in server)
#   CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET (no Cloudinary SDK in server)
#   FIREBASE_*                                                        (firebase-admin not used; push goes through Expo)
#   GOOGLE_ANDROID_CLIENT_ID                                          (used by the mobile app, not the server)
# ──────────────────────────────────────────────────────────────
